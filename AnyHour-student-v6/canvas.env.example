# Copy to canvas.env and fill in ONLY if your institution issues an OAuth Developer Key.
# Never commit canvas.env or share your client secret.
CANVAS_BASE_URL=https://canvas.example.edu
CANVAS_CLIENT_ID=REPLACE_WITH_INSTITUTION_APPROVED_CLIENT_ID
CANVAS_CLIENT_SECRET=REPLACE_WITH_PRIVATE_CLIENT_SECRET
# Must exactly match the redirect URI registered with the Canvas developer key.
CANVAS_REDIRECT_URI=http://127.0.0.1:8000/api/canvas/callback
# If your institution uses scoped developer keys, add its approved endpoint scopes:
# CANVAS_SCOPES='url:GET|/api/v1/courses url:GET|/api/v1/courses/:course_id/assignments'
